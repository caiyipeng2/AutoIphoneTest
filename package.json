{
  "name": "unity-multi-device-test-center",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
